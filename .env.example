# Choose ONE: hosted OpenAI-compatible API, or local Ollama.
# Never commit a real key. Paste it into the app sidebar or set it in your environment.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
